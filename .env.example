# Application Environment: development | testing | production
APP_ENV=development

# Database Connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/web_data_acq

# Output Directory for media assets and JSON exports
OUTPUT_DIR=./output

# Structured Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Default Crawl Configuration Parameters
DEFAULT_CRAWL_DEPTH=2
DEFAULT_RECURSIVE=true
DEFAULT_JAVASCRIPT_FALLBACK=true
DEFAULT_ROBOTS_MODE=respect
DEFAULT_TIMEOUT_SECONDS=15
DEFAULT_MAX_RETRIES=3
DEFAULT_DOMAIN_RATE_LIMIT=2.0
DEFAULT_MAX_CONCURRENCY=3
